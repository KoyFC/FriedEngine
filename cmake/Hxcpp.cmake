# Locates the hxcpp haxelib and provides fried_add_hxcpp_executable(), which
# compiles the C++ generated by `haxe ... -cpp <dir> -D no-compilation`
# together with the hxcpp runtime, using CMake instead of hxcpp's own build
# tool (`haxelib run hxcpp Build.xml`).
#
# The runtime/std source lists and compiler defines below were derived by
# inspecting a real `haxelib run hxcpp Build.xml` invocation for hxcpp 4.3.2
# on Linux64. If the hxcpp version changes, re-run a plain
# `haxe -cp src -main Main -cpp <dir>` build once (without -D no-compilation)
# and diff its compiler output against this file.

if(NOT HXCPP_ROOT)
    find_program(HAXELIB_EXECUTABLE haxelib REQUIRED)

    execute_process(
        COMMAND ${HAXELIB_EXECUTABLE} path hxcpp
        OUTPUT_VARIABLE _hxcpp_path_output
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _hxcpp_path_result
    )
    if(NOT _hxcpp_path_result EQUAL 0)
        message(FATAL_ERROR "hxcpp haxelib not found. Run: haxelib install hxcpp")
    endif()

    # `haxelib path hxcpp` prints the include path on the first line and a
    # `-D hxcpp=<version>` compiler flag comment on the second; keep the first.
    string(REPLACE "\r" "" _hxcpp_path_output "${_hxcpp_path_output}")
    string(REPLACE "\n" ";" _hxcpp_path_lines "${_hxcpp_path_output}")
    list(GET _hxcpp_path_lines 0 _hxcpp_root)
    file(TO_CMAKE_PATH "${_hxcpp_root}" _hxcpp_root)
    set(HXCPP_ROOT "${_hxcpp_root}" CACHE PATH "Path to the hxcpp haxelib")
endif()

set(HXCPP_INCLUDE_DIR "${HXCPP_ROOT}/include")

# hxcpp's own Build.xml calls this group "runtime": the core GC/object model.
set(_hxcpp_runtime_sources
    src/hx/Object.cpp
    src/Array.cpp
    src/hx/CFFI.cpp
    src/hx/Date.cpp
    src/hx/Anon.cpp
    src/hx/Boot.cpp
    src/hx/Interface.cpp
    src/Enum.cpp
    src/hx/Class.cpp
    src/Dynamic.cpp
    src/hx/gc/GcRegCapture.cpp
    src/Math.cpp
    src/hx/Hash.cpp
    src/hx/Thread.cpp
    src/hx/gc/Immix.cpp
    src/hx/Lib.cpp
    src/hx/StdLibs.cpp
    src/hx/Debug.cpp
    src/hx/gc/GcCommon.cpp
    src/String.cpp
)

# hxcpp's own Build.xml calls this group "hxcpp_std": native sys.* support.
set(_hxcpp_std_sources
    src/hx/libs/std/Random.cpp
    src/hx/libs/std/File.cpp
    src/hx/libs/std/Socket.cpp
    src/hx/libs/std/Process.cpp
    src/hx/libs/std/Sys.cpp
)

# Neither compiles, or works, on a console or the calculator: none has
# subprocesses, the Vita's sockets are a Sony API rather than the BSD one hxcpp
# is written against, libnx's and libctru's do not open until a socket service
# initialization the engine never calls, and the calculator has no network.
set(_hxcpp_std_sources_without_console
    src/hx/libs/std/Socket.cpp
    src/hx/libs/std/Process.cpp
)

# Used instead of the generated __files__.cpp because we don't build with
# HXCPP_DEBUGGER (matches Build.xml's `unless="HXCPP_DEBUGGER"` file entry).
set(_hxcpp_no_files_source src/hx/NoFiles.cpp)

# hxcpp's std sources are written against glibc; cmake/newlib/ fills in what
# newlib either declares without implementing or does not ship at all.
set(_hxcpp_newlib_dir "${CMAKE_CURRENT_LIST_DIR}/newlib")

function(fried_apply_newlib_compat sources)
    set_source_files_properties(${sources} PROPERTIES
        INCLUDE_DIRECTORIES "${_hxcpp_newlib_dir}"
        COMPILE_OPTIONS "-include;${_hxcpp_newlib_dir}/posix_extras.h"
    )
endfunction()

set(_hxcpp_mingw_dir "${CMAKE_CURRENT_LIST_DIR}/mingw")

# Replaces hxcpp's pthread-key thread local storage on libctru, which has no
# working pthread keys.
set(_hxcpp_libctru_tls_header "${CMAKE_CURRENT_LIST_DIR}/libctru/hx_tls.h")

# PCRE2 is C, and a language enabled inside a function is lost when it returns, so it is enabled here.
enable_language(C)

# hxcpp's regexp library and the PCRE2 it wraps, built the way libs/regexp/Build.xml does: 8-bit PCRE2 always and 16-bit PCRE2 as well with smart strings, without the JIT, which needs a machine-specific code generator.
function(fried_add_hxcpp_regexp target_name)
    set(_pcre_dir "${HXCPP_ROOT}/project/thirdparty/pcre2-10.42/src")
    file(STRINGS "${HXCPP_ROOT}/src/hx/libs/regexp/pcre2_sources.xml" _pcre_entries REGEX "<file name=")
    set(_pcre_sources "")
    foreach(_entry IN LISTS _pcre_entries)
        string(REGEX REPLACE "^.*PCRE_DIR\\}/([^\"]+)\".*$" "\\1" _file "${_entry}")
        list(APPEND _pcre_sources "${_pcre_dir}/${_file}")
    endforeach()

    foreach(_width 8 16)
        # Static libraries, not object libraries: make cannot name an object whose path holds the comma of hxcpp's "4,3,2" folder from another target.
        add_library(${target_name}_pcre${_width} STATIC ${_pcre_sources})
        target_include_directories(${target_name}_pcre${_width} PRIVATE "${_pcre_dir}")
        target_compile_definitions(${target_name}_pcre${_width} PRIVATE
            HAVE_CONFIG_H PCRE2_STATIC SUPPORT_UNICODE PCRE2_CODE_UNIT_WIDTH=${_width} SUPPORT_PCRE2_${_width}
        )
        set_target_properties(${target_name}_pcre${_width} PROPERTIES POSITION_INDEPENDENT_CODE ON)
        target_link_libraries(${target_name} PRIVATE ${target_name}_pcre${_width})
    endforeach()

    target_sources(${target_name} PRIVATE "${HXCPP_ROOT}/src/hx/libs/regexp/RegExp.cpp")
    set_source_files_properties("${HXCPP_ROOT}/src/hx/libs/regexp/RegExp.cpp" PROPERTIES
        INCLUDE_DIRECTORIES "${_pcre_dir}"
        COMPILE_DEFINITIONS "_CRT_SECURE_NO_DEPRECATE;HX_UNDEFINE_H"
    )
endfunction()

# fried_add_hxcpp_executable(<target> <generated_dir>)
#
# <generated_dir> must be the output of
# `haxe -cp <src> -main <Main> -cpp <generated_dir> -D no-compilation`.
function(fried_add_hxcpp_executable target_name generated_dir)
    if(NOT EXISTS "${generated_dir}/Build.xml")
        message(FATAL_ERROR
            "${generated_dir} does not look like a hxcpp -cpp output "
            "directory (no Build.xml found). Run the matching `haxe` build "
            "first."
        )
    endif()

    # Read HXCPP_API_LEVEL back from the actual Haxe compile that produced
    # generated_dir instead of hardcoding it.
    file(STRINGS "${generated_dir}/Options.txt" _api_level_line REGEX "^hxcpp_api_level=")
    string(REPLACE "hxcpp_api_level=" "" _hxcpp_api_level "${_api_level_line}")

    # The sources are the ones Build.xml lists, not whatever is in the directory: the Haxe compiler leaves behind the files of a class that no longer exists, and compiling those fails against the headers that replaced them. Build.xml is a configure dependency so a new class is picked up without a manual reconfigure.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${generated_dir}/Build.xml")
    file(STRINGS "${generated_dir}/Build.xml" _generated_entries REGEX "<file name=\"src/")
    set(_generated_sources "")
    foreach(_entry IN LISTS _generated_entries)
        string(REGEX REPLACE "^.*<file name=\"([^\"]+)\".*$" "\\1" _relative "${_entry}")
        list(APPEND _generated_sources "${generated_dir}/${_relative}")
    endforeach()
    list(FILTER _generated_sources EXCLUDE REGEX "__lib__\\.cpp$")
    list(FILTER _generated_sources EXCLUDE REGEX "__files__\\.cpp$")

    list(TRANSFORM _hxcpp_runtime_sources PREPEND "${HXCPP_ROOT}/" OUTPUT_VARIABLE _runtime_sources)
    set(_std_source_names ${_hxcpp_std_sources})
    if(VITA OR NINTENDO_SWITCH OR NINTENDO_3DS OR NINTENDO_DS OR FRIED_CG50 OR FRIED_WEB)
        list(REMOVE_ITEM _std_source_names ${_hxcpp_std_sources_without_console})
    endif()

    list(TRANSFORM _std_source_names PREPEND "${HXCPP_ROOT}/" OUTPUT_VARIABLE _std_sources)
    set(_no_files_source "${HXCPP_ROOT}/${_hxcpp_no_files_source}")

    set(_include_dir "${HXCPP_INCLUDE_DIR}")
    if(FRIED_CG50)
        fried_cg50_patch_hxcpp(_runtime_sources _include_dir)
    endif()
    if(NINTENDO_DS)
        fried_nds_patch_hxcpp(_runtime_sources)
    endif()

    # SDLActivity loads the game as libmain.so and calls its SDL_main.
    if(FRIED_ANDROID)
        add_library(${target_name} SHARED)
        set_target_properties(${target_name} PROPERTIES OUTPUT_NAME main)
    else()
        add_executable(${target_name})
    endif()
    target_sources(${target_name} PRIVATE
        ${_generated_sources}
        ${_no_files_source}
        ${_runtime_sources}
        ${_std_sources}
    )

    # EReg is the only user of hxcpp's regexp library, and PCRE2 under it is a few hundred KB, so a game that never writes a regular expression does not carry it.
    list(FIND _generated_sources "${generated_dir}/src/EReg.cpp" _ereg_index)
    if(NOT _ereg_index EQUAL -1)
        fried_add_hxcpp_regexp(${target_name})
    endif()

    target_include_directories(${target_name} PRIVATE "${generated_dir}/include")
    target_include_directories(${target_name} SYSTEM PRIVATE "${_include_dir}")

    target_compile_definitions(${target_name} PRIVATE
        HXCPP_API_LEVEL=${_hxcpp_api_level}
        HXCPP_VISIT_ALLOCS
        HX_SMART_STRINGS
    )

    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        target_compile_definitions(${target_name} PRIVATE HXCPP_M64)
    endif()

    if(VITA OR NINTENDO_SWITCH OR NINTENDO_3DS OR NINTENDO_DS OR FRIED_CG50)
        # hxcpp has no target of its own for any of the consoles or the
        # calculator: HX_LINUX and NEKO_LINUX pick its generic POSIX paths, and
        # none of them loads a shared library.
        target_compile_definitions(${target_name} PRIVATE
            HX_LINUX
            NEKO_LINUX
            HXCPP_NO_DYNAMIC_LOADING
        )

        if(FRIED_CG50)
            fried_cg50_configure_hxcpp_target(${target_name})
        else()
            fried_apply_newlib_compat("${_std_sources}")
            target_sources(${target_name} PRIVATE "${_hxcpp_newlib_dir}/posix_extras.cpp")
        endif()

        if(NINTENDO_3DS OR NINTENDO_DS)
            target_compile_definitions(${target_name} PRIVATE
                "HX_TLS_H_OVERRIDE=\"${_hxcpp_libctru_tls_header}\""
            )
        endif()

        if(NINTENDO_DS)
            target_sources(${target_name} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/nds/runtime.cpp")
        endif()
    elseif(FRIED_WEB)
        # hxcpp's own emscripten toolchain passes -DEMSCRIPTEN; emcc only defines __EMSCRIPTEN__.
        target_compile_definitions(${target_name} PRIVATE EMSCRIPTEN HX_LINUX NEKO_LINUX)

        # Clang is stricter than the GCC hxcpp is written against, about code that is hxcpp's or generated, and
        # EMSCRIPTEN itself is the macro it deprecates.
        target_compile_options(${target_name} PRIVATE
            -Wno-parentheses-equality
            -Wno-deprecated-pragma
            -Wno-nontrivial-memcall
            -Wno-return-type-c-linkage
        )
    elseif(FRIED_ANDROID)
        # hxcpp's own Android define; the NDK already passes -DANDROID. Without HXCPP_EXE_LINK its main is hxcpp_main(), which android/sdl_main.cpp calls.
        target_compile_definitions(${target_name} PRIVATE HX_ANDROID)
        target_compile_options(${target_name} PRIVATE
            -Wno-invalid-offsetof
            -Wno-return-type-c-linkage
            -Wno-parentheses
        )
        target_sources(${target_name} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/android/sdl_main.cpp")
        target_link_libraries(${target_name} PRIVATE log android)
        # Devices with 16 KB memory pages refuse a library aligned to 4 KB.
        target_link_options(${target_name} PRIVATE "LINKER:-z,max-page-size=16384")
    elseif(APPLE)
        target_compile_definitions(${target_name} PRIVATE HX_MACOS)
    elseif(WIN32)
        target_compile_definitions(${target_name} PRIVATE HX_WINDOWS)
        target_link_libraries(${target_name} PRIVATE ws2_32)

        if(MINGW)
            # hxcpp keys its Dynamic(long) overloads off __WORDSIZE, which only
            # glibc defines, and a Windows long is 32 bits.
            target_compile_definitions(${target_name} PRIVATE __WORDSIZE=32)
            # Socket.cpp redefines _WIN32_WINNT to this after MinGW's headers have set their own.
            set_source_files_properties("${HXCPP_ROOT}/src/hx/libs/std/Socket.cpp" PROPERTIES
                INCLUDE_DIRECTORIES "${_hxcpp_mingw_dir}"
                COMPILE_DEFINITIONS _WIN32_WINNT=0x0501
                COMPILE_OPTIONS -Wno-attributes
            )
            target_link_options(${target_name} PRIVATE
                -static
                $<$<NOT:$<CONFIG:Debug>>:-mwindows>
            )
        elseif(MSVC)
            # hxcpp declares main(), not the WinMain() the GUI subsystem enters through by default.
            target_link_options(${target_name} PRIVATE
                $<$<NOT:$<CONFIG:Debug>>:/SUBSYSTEM:WINDOWS>
                $<$<NOT:$<CONFIG:Debug>>:/ENTRY:mainCRTStartup>
            )
        endif()
    else()
        target_compile_definitions(${target_name} PRIVATE HX_LINUX)
    endif()

    if(MSVC)
        target_compile_options(${target_name} PRIVATE /bigobj)
    else()
        target_compile_options(${target_name} PRIVATE
            -fvisibility=hidden -Wno-overflow
        )
    endif()

    # hxcpp reads the flags word in front of each string literal as an int.
    # -Oz stops GCC aligning string literals to a word, and an unaligned load
    # on the ARM9 comes back rotated, so a string is taken for the wrong
    # encoding and Json.parse() fails.
    if(NINTENDO_DS)
        target_compile_options(${target_name} PRIVATE $<$<CONFIG:MinSizeRel>:-O2>)
    endif()

    if(FRIED_FLOAT32)
        target_compile_definitions(${target_name} PRIVATE HXCPP_FLOAT32 FRIED_FLOAT32)
    endif()

    set_source_files_properties(${_runtime_sources} PROPERTIES
        COMPILE_DEFINITIONS "_CRT_SECURE_NO_DEPRECATE;HX_UNDEFINE_H"
    )

    set_source_files_properties("${generated_dir}/src/__main__.cpp" PROPERTIES
        COMPILE_DEFINITIONS "HX_DECLARE_MAIN"
    )

    if(VITA OR NINTENDO_SWITCH OR NINTENDO_3DS OR NINTENDO_DS OR FRIED_CG50)
        # Neither newlib's struct tm nor fxlibc's has tm_gmtoff. __SNC__ is one
        # of the defines Date.cpp keys its mktime() fallback off, and uses for
        # nothing else.
        set_property(SOURCE "${HXCPP_ROOT}/src/hx/Date.cpp"
            APPEND PROPERTY COMPILE_DEFINITIONS __SNC__
        )
    endif()

    # gint has no threads to link at all; cmake/gint/pthread.h stands in.
    if(VITA OR NINTENDO_SWITCH OR NINTENDO_3DS OR NINTENDO_DS)
        target_link_libraries(${target_name} PRIVATE pthread)
    elseif(NOT FRIED_CG50 AND NOT FRIED_WEB)
        find_package(Threads REQUIRED)
        target_link_libraries(${target_name} PRIVATE Threads::Threads)
    endif()

    # Pinned, not the minimum target_compile_features() asks for: hxcpp 4.3.2
    # is written for C++17, and in C++20 cpp::VirtualArray::operator== resolves
    # to itself through the reversed candidate.
    set_target_properties(${target_name} PROPERTIES
        CXX_STANDARD 17
        CXX_STANDARD_REQUIRED ON
    )

    # A .3dsx is relocated by its loader from -mword-relocations, not as a PIE,
    # and a .g3a is linked to the fixed address the calculator maps it at.
    if(NOT VITA AND NOT NINTENDO_3DS AND NOT NINTENDO_DS AND NOT FRIED_CG50 AND NOT FRIED_WEB)
        set_target_properties(${target_name} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    endif()
endfunction()
