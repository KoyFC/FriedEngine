pkgname=3ds-sdl2
pkgver=2.32.10
pkgrel=1
pkgdesc='A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Nintendo 3DS port)'
arch=('any')
url='https://libsdl.org'
license=('Zlib')
options=(!strip !buildflags staticlibs)
depends=('libctru')
makedepends=('3ds-cmake' '3ds-pkg-config')
source=("https://github.com/libsdl-org/SDL/releases/download/release-${pkgver}/SDL2-${pkgver}.tar.gz")
sha256sums=('5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165')

build() {
  cmake -S SDL2-${pkgver} -B build \
    -DCMAKE_TOOLCHAIN_FILE="${DEVKITPRO}/cmake/3DS.cmake" \
    -DCMAKE_INSTALL_PREFIX="${DEVKITPRO}/portlibs/3ds" \
    -DCMAKE_BUILD_TYPE=Release \
    -DSDL_SHARED=OFF \
    -DSDL_STATIC=ON \
    -DSDL_TEST=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
