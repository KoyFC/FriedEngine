pkgname=3ds-sdl2_ttf
pkgver=2.24.0
pkgrel=1
pkgdesc='SDL2 TrueType font library (Nintendo 3DS port)'
arch=('any')
url='https://github.com/libsdl-org/SDL_ttf'
license=('Zlib')
options=(!strip !buildflags staticlibs)
depends=('3ds-sdl2' '3ds-freetype')
makedepends=('3ds-cmake' '3ds-pkg-config')
source=("https://github.com/libsdl-org/SDL_ttf/releases/download/release-${pkgver}/SDL2_ttf-${pkgver}.tar.gz")
sha256sums=('0b2bf1e7b6568adbdbc9bb924643f79d9dedafe061fa1ed687d1d9ac4e453bfd')

build() {
  cmake -S SDL2_ttf-${pkgver} -B build \
    -DCMAKE_TOOLCHAIN_FILE="${DEVKITPRO}/cmake/3DS.cmake" \
    -DCMAKE_INSTALL_PREFIX="${DEVKITPRO}/portlibs/3ds" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DSDL2TTF_SAMPLES=OFF \
    -DSDL2TTF_VENDORED=OFF \
    -DSDL2TTF_HARFBUZZ=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
